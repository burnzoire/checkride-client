{
  "name": "checkride-client",
  "version": "1.1.6",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "electron .",
    "prepare:lua": "node scripts/prepare-lua-version.js",
    "deploy:lua": "node scripts/deploy-lua.js",
    "predist": "npm run prepare:lua",
    "dist": "electron-builder",
    "prerelease": "npm run prepare:lua",
    "release": "electron-builder --publish=always",
    "release:tag": "bash scripts/release.sh"
  },
  "engines": {
    "node": "^20.12.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!demo/**",
      "!scripts/**",
      "!jest.config.js",
      "!babel.config.js",
      "!index.js",
      "!main.js",
      "!__tests__/**",
      "!**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burnzoire/checkride-client.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/burnzoire/checkride-client/issues"
  },
  "homepage": "https://github.com/burnzoire/checkride-client#readme",
  "build": {
    "appId": "com.burnzoire.checkride",
    "productName": "Checkride Client",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "files": [
      "**/*",
      "!**/__tests__/**",
      "!**/*.test.js",
      "!**/*.test.js.skip",
      "!**/*.map",
      "!coverage/**"
    ],
    "extraResources": [
      {
        "from": "build/lua-versioned/Scripts/Hooks/DCS-Checkride-hook.lua",
        "to": "dcs/Scripts/Hooks/DCS-Checkride-hook.lua"
      },
      {
        "from": "build/lua-versioned/Mods/Services/DCS-Checkride/Scripts/DCS-CheckrideGameGUI.lua",
        "to": "dcs/Mods/Services/DCS-Checkride/Scripts/DCS-CheckrideGameGUI.lua"
      },
      {
        "from": "build/lua-versioned/Mods/Services/DCS-Checkride/Scripts/DCS-CheckrideMission.lua",
        "to": "dcs/Mods/Services/DCS-Checkride/Scripts/DCS-CheckrideMission.lua"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.3.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "nock": "^14.0.13"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "uuid": "^8.3.2",
    "ws": "^8.19.0"
  }
}
